{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pposintel.local/schemas/global-resource-atlas.schema.json",
  "title": "Global Resource Atlas",
  "type": "object",
  "required": [
    "snapshotKey",
    "snapshotDate",
    "regions"
  ],
  "additionalProperties": false,
  "properties": {
    "snapshotKey": {
      "type": "string",
      "minLength": 1
    },
    "snapshotDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/RegionResourceView"
      }
    }
  },
  "$defs": {
    "CoverageStatus": {
      "type": "string",
      "enum": [
        "seed",
        "partial",
        "verified",
        "stale",
        "unknown"
      ]
    },
    "DataQuality": {
      "type": "string",
      "enum": [
        "public",
        "estimated",
        "mixed",
        "unverified"
      ]
    },
    "SourceEvidenceRef": {
      "type": "object",
      "properties": {
        "sourceKey": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "accessedAt": {
          "type": "string",
          "minLength": 1
        },
        "verificationStatus": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "sourceKey",
        "title",
        "url",
        "sourceType",
        "accessedAt",
        "verificationStatus",
        "confidence"
      ],
      "additionalProperties": true
    },
    "VolumeMetric": {
      "type": "object",
      "properties": {
        "metricKey": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": ["number", "string"]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "verificationStatus": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "metricKey",
        "name",
        "value",
        "unit",
        "period",
        "scope",
        "definition",
        "sourceUrls",
        "sourceType",
        "verificationStatus",
        "confidence"
      ],
      "additionalProperties": false
    },
    "LatestIntelEvent": {
      "type": "object",
      "properties": {
        "eventKey": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "reviewStatus": {
          "type": "string",
          "minLength": 1
        },
        "sourceEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceEvidenceRef"
          }
        }
      },
      "required": [
        "eventKey",
        "title",
        "publishedAt",
        "scope",
        "reviewStatus",
        "sourceEvidence"
      ],
      "additionalProperties": true
    },
    "CenterProfileView": {
      "type": "object",
      "properties": {
        "centerKey": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQuality"
        },
        "coverageStatus": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "sourceEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceEvidenceRef"
          }
        },
        "volumeMetrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VolumeMetric"
          }
        },
        "latestIntelligence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LatestIntelEvent"
          }
        }
      },
      "required": [
        "centerKey",
        "name",
        "country",
        "city",
        "dataQuality",
        "coverageStatus",
        "sourceEvidence",
        "volumeMetrics",
        "latestIntelligence"
      ],
      "additionalProperties": true
    },
    "CityResourceView": {
      "type": "object",
      "properties": {
        "cityKey": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQuality"
        },
        "coverageStatus": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "centers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CenterProfileView"
          }
        }
      },
      "required": [
        "cityKey",
        "name",
        "country",
        "dataQuality",
        "coverageStatus",
        "centers"
      ],
      "additionalProperties": true
    },
    "CountryResourceView": {
      "type": "object",
      "properties": {
        "countryKey": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "regionKey": {
          "type": "string",
          "minLength": 1
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQuality"
        },
        "coverageStatus": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "cities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CityResourceView"
          }
        }
      },
      "required": [
        "countryKey",
        "name",
        "regionKey",
        "dataQuality",
        "coverageStatus",
        "cities"
      ],
      "additionalProperties": true
    },
    "RegionResourceView": {
      "type": "object",
      "properties": {
        "regionKey": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQuality"
        },
        "coverageStatus": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "countries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CountryResourceView"
          }
        }
      },
      "required": [
        "regionKey",
        "name",
        "dataQuality",
        "coverageStatus",
        "countries"
      ],
      "additionalProperties": true
    }
  }
}
